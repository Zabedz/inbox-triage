# Copy to .env and fill in. Never commit real values.
OPENCODE_API_KEY=
JEV_MODEL=jev-1.13
JEV_ENDPOINT=https://opencode.ai/zen/v1/systemone

# LLM provider. One of: anthropic | zen
LLM_PROVIDER=zen
LLM_MODEL=deepseek-v4.1-flash
ANTHROPIC_API_KEY=
ZEN_BASE_URL=https://opencode.ai/zen/v1

# Decision backend for decision nodes: jev | llm
DECISION_BACKEND=jev
# Personal names to redact before external calls (comma-separated)
CANDIDATE_NAMES=

# Tracker source (status changes go through TRACKER_SET_STATUS) and local working copy
TRACKER_APPLICATIONS=~/Projects/career-ops/data/applications.md
TRACKER_STATUS_LOG=~/Projects/career-ops/data/status-log.tsv
TRACKER_ACTIVE_INTERVIEWS=~/Projects/career-ops/data/active-interviews.md
DATA_DIR=./data
# career-ops CLI for tracker status writes (default: next to TRACKER_APPLICATIONS' data dir)
TRACKER_SET_STATUS=~/Projects/career-ops/set-status.mjs
# Absolute node path; launchd does not load nvm's PATH
NODE_BIN=

# Guard auto-apply thresholds (set from evals/calibrate.py output)
GUARD_CATEGORY_THRESHOLD=0.99
GUARD_MATCH_THRESHOLD=0.99

# Gmail (gmail.modify for labels; it also permits send, which the code never calls)
GMAIL_TOKEN=./data/gmail-token.json
